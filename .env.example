# BizNext Agent — пример конфигурации.
# Скопируйте в .env:  python scripts/init_env.py   (заполнит пароли БД случайными значениями)
# Пароли должны быть URL-safe (буквы/цифры) — они подставляются в строки подключения.

# ---------- Общие ----------
COMPOSE_PROJECT_NAME=biznext
APP_TIMEZONE=Asia/Almaty
# Порт веб-интерфейса на хосте
WEB_PORT=8095

# ---------- PostgreSQL ----------
POSTGRES_DB=biznext
# Владелец БД: создаёт схемы, наполняет demo-данными. Агент и приложение его НЕ используют.
POSTGRES_USER=biznext_owner
POSTGRES_PASSWORD=change-me-owner
# Пользователь приложения: история диалогов и traces (схема app)
APP_DB_USER=biznext_app
APP_DB_PASSWORD=change-me-app
# Пользователь агента: только SELECT на схему demo, read-only транзакции
AGENT_DB_USER=agent_readonly
AGENT_DB_PASSWORD=change-me-agent
# Схема с бизнес-данными, доступная агенту
DATA_SCHEMA=demo
# Пользователь приёма данных от коннекторов (§56): пишет только канонические схемы источников
INGEST_DB_USER=biznext_ingest
INGEST_DB_PASSWORD=change-me-ingest

# ---------- Demo data ----------
# Фиксированный seed генератора — одинаковые данные при каждом пересоздании
SEED_RANDOM_SEED=20260914
# Пустое значение = данные заканчиваются сегодняшним днём (по APP_TIMEZONE)
SEED_END_DATE=
# 1 = пересоздать demo-данные, даже если они уже есть
SEED_FORCE=0

# ---------- 1C connector, демо-режим (§56, docs/CONNECTORS.md) ----------
# Токен, с которым BizNext Connector отправляет данные источника onec_demo в ingest API
CONNECTOR_TOKEN=change-me-connector-token
# Пользователь публикации 1С (эмулятор) с правами только на чтение
ONEC_DEMO_USER=biznext_reader
ONEC_DEMO_PASSWORD=change-me-onec
# Инкрементальная синхронизация каждые N минут; полная перезагрузка раз в сутки после этого времени
SYNC_INTERVAL_MINUTES=30
FULL_SYNC_TIME=03:40
# Поля канонического контракта, которые коннектор не запрашивает у 1С и не передаёт
CONNECTOR_EXCLUDE_FIELDS=customers.tax_id,suppliers.tax_id

# ---------- LLM provider ----------
# anthropic | openai | openai_compatible  (openai = официальный endpoint OpenAI)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
LLM_API_KEY=
# Только для openai_compatible: OpenAI, OpenRouter, Ollama, vLLM и т.п.
LLM_BASE_URL=
# anthropic: low | medium | high | xhigh | max;  openai: low | medium | high (xhigh/max → high)
LLM_EFFORT=high
LLM_MAX_OUTPUT_TOKENS=16000
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
# auto = включить server-side refusal fallbacks для моделей, которые их поддерживают
LLM_FALLBACKS=auto

# ---------- Лимиты агента (контроль стоимости) ----------
AGENT_MAX_ITERATIONS=10
AGENT_MAX_TOOL_CALLS=30
AGENT_MAX_SQL_RETRIES=3
AGENT_MAX_ROWS_TO_LLM=60
AGENT_MAX_RESULT_CHARS_TO_LLM=12000
AGENT_TIMEOUT_SECONDS=180
AGENT_HISTORY_TURNS=6

# ---------- SQL safety ----------
SQL_MAX_ROWS=500
SQL_STATEMENT_TIMEOUT_MS=15000

# ---------- Admin / observability ----------
# Если задан — список traces доступен только с заголовком X-Admin-Token
ADMIN_TOKEN=
INSIGHTS_CACHE_SECONDS=3600
LOG_LEVEL=INFO
